<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/animeplay_icon_orchid"
        android:label="AnimePlay"
        android:roundIcon="@drawable/animeplay_icon_orchid"
        android:supportsRtl="true"
        android:theme="@style/Theme.AnimePlay"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="unspecified" />

        <activity-alias
            android:name=".LauncherOrchid"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/animeplay_icon_orchid"
            android:label="AnimePlay"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherSakura"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/animeplay_icon_sakura"
            android:label="AnimePlay"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherNeon"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/animeplay_icon_neon"
            android:label="AnimePlay"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
